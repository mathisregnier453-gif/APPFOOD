# Copier en .env (non versionné). Ces deux valeurs sont PUBLIQUES par conception
# (protégées par les règles RLS). Aucune clé secrète ne doit figurer ici.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Clés SDK RevenueCat PUBLIQUES (une par store, tableau de bord RevenueCat > API keys).
# La clé secrète (sk_...) ne va JAMAIS ici : c'est un secret des edge functions.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_...
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_...

# Observabilité (valeurs publiques par conception)
EXPO_PUBLIC_SENTRY_DSN=https://...@o0.ingest.de.sentry.io/0
EXPO_PUBLIC_POSTHOG_KEY=phc_...
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
