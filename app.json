{
  "expo": {
    "name": "Sauge",
    "slug": "sauge",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.sauge.app",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#6E8F72",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sauge.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Sauge utilise l'appareil photo pour photographier votre réfrigérateur, congélateur ou placards et reconnaître les aliments.",
          "photosPermission": "Sauge accède à vos photos uniquement si vous choisissez d'importer une photo de votre frigo."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#7A9A7E",
          "icon": "./assets/notification-icon.png"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Sauge utilise l'appareil photo pour scanner vos aliments et lire les codes-barres.",
          "recordAudioAndroid": false
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "organization": "A_RENSEIGNER",
          "project": "sauge"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F7F5F0"
        }
      ],
      "./plugins/withEmbeddedDebugBundle"
    ],
    "scheme": "sauge",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "privacyPolicyUrl": "https://mathisregnier453-gif.github.io/APPFOOD/confidentialite.html",
      "termsUrl": "https://mathisregnier453-gif.github.io/APPFOOD/conditions.html",
      "supportEmail": "mathisregnier453@gmail.com",
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "9e658e44-f8c3-4712-8977-4fcc9169c92e"
      }
    },
    "description": "Scannez votre frigo, suivez vos aliments, cuisinez ce que vous avez et faites des courses malignes.",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "sauge"
  }
}
